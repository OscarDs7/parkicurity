<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="22dp"
        tools:context=".EstadisticasFragment">

        <!-- 🔵 TÍTULO -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Dashboard Parkicurity"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ⚪ SUBTÍTULO -->
        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado general del sistema en tiempo real"
            android:textColor="#707070"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 📊 CARD PRINCIPAL -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEstadisticas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            android:backgroundTint="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/txtSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TÍTULO DE SECCIÓN -->
                <TextView
                    android:id="@+id/txtEstadisticas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Cargando estadísticas..."
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1D1D1D" />

                <!-- DIVISOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.3dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E6E6E6" />


                <!-- =============================== -->
                <!-- 🔥 TEMPERATURA -->
                <!-- =============================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                    <TextView
                        android:id="@+id/txtTituloTemperatura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text= "Temperatura"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="#1D1D1D"
                        android:paddingBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp">

                        <TextView
                            android:id="@+id/txtTempMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Media: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtTempMin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Mínimo: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtTempMax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Máximo: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtTempVar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Varianza: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtTempStd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Desviación estándar: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                    </LinearLayout>
                </LinearLayout>


                <!-- =============================== -->
                <!-- 💧 HUMEDAD -->
                <!-- =============================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="18dp">

                    <TextView
                        android:id="@+id/txtTituloHumedad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Humedad"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="#1D1D1D"
                        android:paddingBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp">

                        <TextView
                            android:id="@+id/txtHumMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Media: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtHumMin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Mínimo: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtHumMax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Máximo: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtHumVar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Varianza: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtHumStd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Desviación estándar: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                    </LinearLayout>
                </LinearLayout>


                <!-- =============================== -->
                <!-- 📏 DISTANCIA -->
                <!-- =============================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="18dp">

                    <TextView
                        android:id="@+id/txtTituloDistancia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Distancia"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="#1D1D1D"
                        android:paddingBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp">

                        <TextView
                            android:id="@+id/txtDistMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Media: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtDistMin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Mínimo: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtDistMax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Máximo: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtDistVar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Varianza: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtDistStd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Desviación estándar: --"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                    </LinearLayout>
                </LinearLayout>

                <!-- DIVISOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.3dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="5dp"
                    android:background="#E6E6E6" />

                <!-- =============================== -->
                <!-- 🔍 INTERPRETACIÓN -->
                <!-- =============================== -->
                <TextView
                    android:id="@+id/txtInterpretacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Interpretación..."
                    android:textSize="15.5sp"
                    android:textColor="#4B4B4B"
                    android:textStyle="bold"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
